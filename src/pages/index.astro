---
import Layout from "../layouts/Layout.astro";
import RepairCostCalculator from "../components/RepairCostCalculator.astro";
---

<Layout>
  <main class="min-h-screen">
    <!-- Nav -->
    <nav class="border-b border-[var(--color-hairline)] bg-[var(--color-elevated)]">
      <div class="max-w-5xl mx-auto px-6 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded bg-[var(--color-ink)] flex items-center justify-center">
            <span class="text-white text-xs font-bold">W</span>
          </div>
          <span class="text-sm font-semibold text-[var(--color-ink)] tracking-tight">Wakefit</span>
        </div>
        <span class="text-xs text-[var(--color-muted)] font-mono uppercase tracking-wider">Repair Calculator</span>
      </div>
    </nav>

    <!-- Hero -->
    <section class="py-12 md:py-16 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[var(--color-hairline)] bg-[var(--color-elevated)] text-xs text-[var(--color-muted)] mb-5">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)]"></span>
          Sofa Repair Now Available
        </div>
        <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-[var(--color-ink)] leading-tight mb-3">
          Repair Cost Calculator
        </h1>
        <p class="text-base text-[var(--color-body)] max-w-xl mx-auto">
          Select your product category, SKU, and the issues you're facing to get an instant repair cost estimate.
        </p>
      </div>
    </section>

    <!-- Calculator -->
    <section class="px-6 pb-16">
      <RepairCostCalculator />
    </section>

    <!-- Footer -->
    <footer class="border-t border-[var(--color-hairline)] py-8 px-6">
      <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-[var(--color-muted)]">
        <span>© 2026 Wakefit. All rights reserved.</span>
        <a
          href="https://www.linkedin.com/in/kshitijas/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--color-ink)] hover:text-blue-600 transition-colors inline-flex items-center gap-1.5 font-medium underline underline-offset-4 decoration-[var(--color-hairline)] hover:decoration-blue-600"
        >
          <span>Designed and Automated by Kshitij Sawarkar</span>
          <svg class="w-3.5 h-3.5 fill-current opacity-80" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.2a1.66 1.66 0 0 0-1.66 1.66c0 .92.74 1.66 1.66 1.66.92 0 1.66-.74 1.66-1.66A1.66 1.66 0 0 0 7.83 6.2Z"/>
          </svg>
        </a>
        <span class="font-mono">Repair Cost Calculator v1.0</span>
      </div>
    </footer>
  </main>
</Layout>
